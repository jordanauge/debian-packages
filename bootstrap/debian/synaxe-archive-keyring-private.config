#!/bin/sh
set -eu
# shellcheck source=/dev/null
. /usr/share/debconf/confmodule
auth=/etc/apt/auth.conf.d/synaxe.conf
if [ -s "$auth" ] && [ "${1:-}" != reconfigure ]; then
    exit 0
fi
db_input high synaxe-archive-keyring-private/username || test "$?" = 30
db_input high synaxe-archive-keyring-private/password || test "$?" = 30
db_go
