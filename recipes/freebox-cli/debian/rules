#!/usr/bin/make -f
export PYBUILD_NAME=freebox-cli
export PYBUILD_TEST_PYTEST=1
export PYBUILD_TEST_ARGS=--ignore=tests/test_mcp.py
# pybuild blocks external networking; local fake WebSocket servers need loopback.
export no_proxy=localhost,127.0.0.1,::1
export NO_PROXY=localhost,127.0.0.1,::1
%:
	dh $@ --with python3 --buildsystem=pybuild
